# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. In Docker Compose the host is `db`.
DATABASE_URL="postgresql://nexahr:nexahr@localhost:5432/nexahr?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true
# Public origin of the app (used for password reset links and callbacks).
APP_URL="http://localhost:3000"

# ─── AI HR Copilot (disabled by default) ─────────────────────────────────────
# The copilot stays disabled unless AI_ENABLED=true AND an API key is present.
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI proxy, OpenRouter,
# local vLLM/Ollama). Never commit real keys.
AI_ENABLED="false"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
# Allow sending employee records (PII) to the provider. Off by default.
AI_ALLOW_CONFIDENTIAL_DATA="false"
AI_TIMEOUT_MS="30000"

# ─── Mail notification abstraction (console in development) ──────────────────
MAIL_DRIVER="console"          # console | smtp
MAIL_FROM="no-reply@nexahr.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
